# Root .env consumed by docker-compose. Each var has a sensible default in the
# compose file, so this entire file is optional for local dev. Override what
# you need (especially in production).

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nutrilens
POSTGRES_PORT=5433

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me-in-prod-this-is-only-for-local-compose
JWT_EXPIRES_IN=7d

# AI provider: "mock" (default, no key needed) or "openai" (requires key)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Storage: "local" (writes to api-uploads volume) or "s3" (set the S3_* vars)
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

MAX_UPLOAD_MB=10
AI_RATE_LIMIT_PER_MINUTE=10

# Comma-separated list. Lock to your real frontend host in production.
CORS_ORIGINS=http://localhost:3000

# ─── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
