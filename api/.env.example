# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nutrilens

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI Provider ---
# Pick one: "gemini" | "openai" | "mock"
#
# - gemini: Free tier (15 RPM, 1500/day) on gemini-2.5-flash. Get a key at
#           https://aistudio.google.com/apikey
# - openai: Paid. Get a key at https://platform.openai.com/api-keys
# - mock:   Deterministic fixtures for offline dev, no key required.
#
# If you set "gemini" or "openai" but the corresponding key is empty, the
# worker logs a warning and uses the mock analyzer until you add a key. If
# the real provider returns an error mid-flight (rate limit, network, model
# not found, ...), the worker also falls back to mock so meals are never
# left empty — the failure reason is recorded in `aiResult._provenance`.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Limits ---
MAX_UPLOAD_MB=10
AI_RATE_LIMIT_PER_MINUTE=10
